    {
      "parameters": {
        "jsCode": "const task = $json;\nconst input = $('Validate Input').first().json;\nconst plan = $('Build Campaign Tasks').first().json.campaign_plan;\n\nconst requiresApproval =\n  input.campaign_type === 'paid_ads' ||\n  input.budget > 0;\n\nreturn {\n  json: {\n    success: true,\n    business_id: input.business_id,\n    campaign_type: input.campaign_type,\n    platform: input.platform,\n    objective: input.objective,\n    budget: input.budget,\n\n    task_id: task.task_id,\n    task: task.task,\n\n    campaign_plan: plan,\n\n    action: {\n      type: input.campaign_type === 'paid_ads'\n        ? 'paid_campaign'\n        : 'marketing_campaign',\n      status: requiresApproval ? 'approval_required' : 'planned',\n      requires_approval: requiresApproval\n    }\n  }\n};"
      },
