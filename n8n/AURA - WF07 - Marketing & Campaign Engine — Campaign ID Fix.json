    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a structured marketing campaign plan.\n\nCampaign type: {{ $json.campaign_type }}\nPlatform: {{ $json.platform }}\nObjective: {{ $json.objective }}\nBudget: {{ $json.budget }}\n\nCreate:\n- campaign objective\n- target audience\n- campaign strategy\n- key message\n- content requirements\n- landing page requirements\n- call to action\n- budget allocation\n- tracking requirements\n- success metrics\n- approval requirements\n\nImportant rules:\n- Do not invent real customer data.\n- Do not create fake leads, fake conversions, or fake results.\n- Do not recommend spam, unauthorized bulk messaging, or platform restriction bypass.\n- For paid campaigns, treat spending as approval-required.\n- Keep the plan practical and measurable.\n\nReturn only structured planning information.",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -896,
        -64
      ],
      "id": "36489270-a45f-43bc-b869-ded4d0867f84",
      "name": "Campaign Planner"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"campaign_objective\": {\n      \"type\": \"string\"\n    },\n    \"target_audience\": {\n      \"type\": \"string\"\n    },\n    \"campaign_strategy\": {\n      \"type\": \"string\"\n    },\n    \"key_message\": {\n      \"type\": \"string\"\n    },\n    \"content_requirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"landing_page_requirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"call_to_action\": {\n      \"type\": \"string\"\n    },\n    \"budget_allocation\": {\n      \"type\": \"string\"\n    },\n    \"tracking_requirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"success_metrics\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"approval_requirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"campaign_objective\",\n    \"target_audience\",\n    \"campaign_strategy\",\n    \"key_message\",\n    \"content_requirements\",\n    \"landing_page_requirements\",\n    \"call_to_action\",\n    \"budget_allocation\",\n    \"tracking_requirements\",\n    \"success_metrics\",\n    \"approval_requirements\"\n  ]\n}"
      },
