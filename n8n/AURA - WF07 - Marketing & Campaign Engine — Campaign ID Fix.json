    {
      "parameters": {
        "jsCode": "const data = $json.body ?? $json;\n\nconst businessId = String(data.business_id ?? '').trim();\nconst campaignType = String(data.campaign_type ?? 'organic').trim().toLowerCase();\nconst platform = String(data.platform ?? '').trim().toLowerCase();\nconst objective = String(data.objective ?? '').trim();\nconst budget = Number(data.budget ?? 0);\n\nconst uuidRegex =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (!businessId) {\n  return {\n    json: {\n      success: false,\n      valid: false,\n      error: 'business_id is required'\n    }\n  };\n}\n\nif (!uuidRegex.test(businessId)) {\n  return {\n    json: {\n      success: false,\n      valid: false,\n      error: 'Invalid business_id UUID'\n    }\n  };\n}\n\nconst allowedCampaignTypes = [\n  'organic',\n  'paid_ads',\n  'email',\n  'affiliate'\n];\n\nif (!allowedCampaignTypes.includes(campaignType)) {\n  return {\n    json: {\n      success: false,\n      valid: false,\n      error: 'Invalid campaign_type',\n      allowed_types: allowedCampaignTypes\n    }\n  };\n}\n\nif (!platform) {\n  return {\n    json: {\n      success: false,\n      valid: false,\n      error: 'platform is required'\n    }\n  };\n}\n\nif (!objective) {\n  return {\n    json: {\n      success: false,\n      valid: false,\n      error: 'objective is required'\n    }\n  };\n}\n\nif (!Number.isFinite(budget) || budget < 0) {\n  return {\n    json: {\n      success: false,\n      valid: false,\n      error: 'Invalid budget'\n    }\n  };\n}\n\nreturn {\n  json: {\n    success: true,\n    valid: true,\n    business_id: businessId,\n    campaign_type: campaignType,\n    platform,\n    objective,\n    budget\n  }\n};"
      },
