    {
      "parameters": {
        "jsCode": "const plan = $json.output ?? $json;\nconst input = $('Validate Input').first().json;\n\nconst requirements = [\n  ...(plan.content_requirements ?? []),\n  ...(plan.landing_page_requirements ?? [])\n];\n\nreturn {\n  json: {\n    success: true,\n    business_id: input.business_id,\n    campaign_type: input.campaign_type,\n    platform: input.platform,\n    objective: input.objective,\n    budget: input.budget,\n\n    campaign_plan: plan,\n\n    tasks: requirements.map((task, index) => ({\n      task_id: `campaign_task_${index + 1}`,\n      task,\n      status: 'pending'\n    }))\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
